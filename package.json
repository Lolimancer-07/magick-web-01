{
  "name": "magick-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:worker": "esbuild src/engine/magick.worker.ts --bundle --format=esm --target=es2022 --outfile=public/magick.worker.js",
    "dev": "npm run build:worker && next dev",
    "build": "npm run build:worker && next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "postinstall": "mkdir -p public/wasm && (cp node_modules/@imagemagick/magick-wasm/dist/magick.wasm public/wasm/ 2>/dev/null || cp node_modules/@imagemagick/magick-wasm/dist/x64/magick.wasm public/wasm/) && npm run build:worker"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@imagemagick/magick-wasm": "0.0.44",
    "lucide-react": "^1.57.0",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
